# ══════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT settings for docker-compose.yml
# Copy this file to .env (git-ignored) and fill in values. Never commit .env.
# ══════════════════════════════════════════════════════════════════════════

# Postgres password for the local dev database (used when the volume is first created)
POSTGRES_PASSWORD=change-me

# Random string, at least 64 characters. PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 80 | ForEach-Object {[char]$_})
JWT_SECRET=change-me-to-a-random-string-of-at-least-64-characters-xxxxxxxxxxxxxxxxxxxx

# Only needed if you start pgAdmin: docker compose --profile tools up -d
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
