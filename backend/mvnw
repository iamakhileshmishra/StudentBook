# If JAVA_HOME is not set, try to detect it
if [ -z "$JAVA_HOME" ]; then
  if command -v java > /dev/null 2>&1; then
    JAVA_HOME=$(java -XshowSettings:properties -version 2>&1 | grep "java.home" | sed 's/.*= //')
  fi
fi

APP_HOME=$(cd "$(dirname "$0")" && pwd)

MAVEN_WRAPPER_JAR="$APP_HOME/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$APP_HOME/.mvn/wrapper/maven-wrapper.properties"

# Read the distribution URL from properties
DISTRIBUTION_URL=$(grep distributionUrl "$MAVEN_WRAPPER_PROPERTIES" | sed 's/distributionUrl=//')

# Download Maven if not present
MAVEN_HOME="$HOME/.m2/wrapper/dists/apache-maven-3.9.9"
if [ ! -d "$MAVEN_HOME" ]; then
  mkdir -p "$MAVEN_HOME"
  echo "Downloading Maven 3.9.9..."
  curl -sL "https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.tar.gz" \
    | tar -xz -C "$MAVEN_HOME" --strip-components=1
fi

exec "$MAVEN_HOME/bin/mvn" "$@"