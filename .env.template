# ══════════════════════════════════════════════════════════════════════════
# School ERP — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/schoolerp
DATABASE_USERNAME=schoolerp
DATABASE_PASSWORD=CHANGE_ME_IN_PRODUCTION

# JWT — Must be at least 64 characters for HS256
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_STRING_NEVER_SHARE_THIS_KEY!!!

# CORS — Your frontend URL (no trailing slash)
CORS_ALLOWED_ORIGINS=https://yourschool.yourplatform.com

# Mail (SMTP) — used to send login details to newly registered schools
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=School ERP <no-reply@yourplatform.com>
FRONTEND_URL=https://yourplatform.com

# Security (see test&bug.md)
# JWT_SECRET must be random, >= 64 chars; the backend refuses the example values above.
COOKIE_SECURE=true
# Set to true only behind a reverse proxy that sets X-Forwarded-For
RATE_LIMIT_TRUST_PROXY=false
APP_TIMEZONE=Asia/Kolkata

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
