# Git ignore rules for StudentBook

# Environment (NEVER commit these)
.env
.env.local
.env.production

# IDE
.idea/
*.iml
.vscode/
*.code-workspace

# Maven
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar

# Node
frontend/node_modules/
frontend/dist/
frontend/.cache/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Docker volumes (local)
postgres_data/

# Old local log files
backend_logs*.txt
